# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=3000

# Required in production: two different random strings, 32+ chars each.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Production database (Postgres, e.g. a free Neon database). Leave empty to use a local SQLite file instead.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Local SQLite only: where the database file lives
# Where the SQLite file and uploaded photos live (mount this as a volume in Docker).
DATA_DIR=./data
# Folder with index.html / styles.css / script.js to serve (default: ../frontend)
# FRONTEND_DIR=../frontend
# Login/register attempts allowed per IP per 15 minutes
AUTH_RATE_LIMIT=20
